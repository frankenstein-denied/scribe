# Optional: the SCRIBE Firebase project is built in (lib/firebase.ts). Set these to point at a different project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to "true" to talk to local emulators (npx firebase emulators:start) instead of the real project.
NEXT_PUBLIC_USE_EMULATORS=
